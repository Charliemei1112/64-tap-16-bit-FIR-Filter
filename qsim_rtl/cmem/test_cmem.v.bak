`timescale 1ns/1ps
`define HALF_CLOCK_PERIOD_2 #500
`define MATLAB_INPUT_FN "../../matlab/fir/cmem_input.txt"
`define QSIM_OUT_FN "./qsim.out"

// testbench for ../../rtl/fir/cmem.v

module testbench();
    reg clk2;
    reg cen;
    reg wen;
    reg [5:0] a;
    reg [15:0] d;
    wire [15:0] q;

    integer i; // loop counter for 64 inputs
    integer error_count;
    integer expected;
    integer input_file;
    integer qsim_out_file;

    // variables for reading the input/output files, need to be decimals
    integer ret_read;

    // instantiate the unit under test
    cmem cmem_0 ( .clk2(clk2), .cen(cen), .wen(wen), .a(a), .d(d), .q(q));

    always begin
        `HALF_CLOCK_PERIOD_2;
        clk2 = ~clk2;
    end

    // open MATLAB coefficient file

    initial begin
        // open MATLAB coefficient file
        // coef_file = $fopen(`MATLAB_COEF_FN, "r");
        // if (coef_file == 0) begin
        //     $display("Error opening MATLAB coefficient file");
        //     $finish;
        // end

        // open MATLAB input file
        input_file = $fopen(`MATLAB_INPUT_FN, "r");
        if (input_file == 0) begin
            $display("Error opening MATLAB input file");
            $finish;
        end

        // open MATLAB output file
        // output_file = $fopen(`MATLAB_OUT_FN, "w");
        // if (output_file == 0) begin
        //     $display("Error opening MATLAB output file");
        //     $finish;
        // end

        // open qsim output file
        qsim_out_file = $fopen(`QSIM_OUT_FN, "w");
        if (qsim_out_file == 0) begin
            $display("Error opening qsim output file");
            $finish;
        end

        // register setup
        clk2 = 0;
        cen = 0;
        wen = 0;
        a = 0;
        d = 0;
        error_count = 0;

        for (i=0; i<64; i=i+1) begin
            // read input from file
            @ (negedge clk2); begin
                a = i;
                ret_read = $fscanf(input_file, "%d", d);
            end 

            @ (posedge clk2);
            #50
            // see if input is written into the memory
            if (d != q) begin
                // $display("Error: input %d not written into memory", d);
                error_count = error_count + 1;
            end
            // write output to qsim output file
            $fwrite(qsim_out_file, "%d\n", d);
        end

        if (error_count == 0) begin
            $display("All tests passed");
        end else begin
            $display("Error: %d tests failed", error_count);
        end

        $fclose(input_file);
        $fclose(qsim_out_file);

        $finish;

    end

endmodule

